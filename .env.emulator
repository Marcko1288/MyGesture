# Configurazione per gli emulatori Firebase (progetto "demo-": nessuna risorsa reale, chiavi fittizie).
# Usata da `vite --mode emulator` e dai test end-to-end.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mygesture.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mygesture
VITE_FIREBASE_STORAGE_BUCKET=demo-mygesture.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_VAPID_KEY=
VITE_USE_EMULATORS=true
