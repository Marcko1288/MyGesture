# Copia in .env.local e compila con i valori della web app Firebase
# (Console Firebase › Impostazioni progetto › Le tue app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mygestion-446b9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mygestion-446b9
VITE_FIREBASE_STORAGE_BUCKET=mygestion-446b9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chiave pubblica Web Push (Console › Cloud Messaging › Certificati Web push)
VITE_FIREBASE_VAPID_KEY=
# true = usa gli emulatori locali (auth 9099, firestore 8080, functions 5001)
VITE_USE_EMULATORS=false
