{
  "name": "mygesture",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "oxlint src functions scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=Europe/Rome vitest run --passWithNoTests",
    "test:watch": "TZ=Europe/Rome vitest",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mygesture \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-tools": "^15.36.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
